{
  "version": 2,
  "builds": [
    { "src": "frontend/package.json", "use": "@vercel/static-build", "config": { "distDir": "build" } },
    { "src": "backend/app.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/backend/app.py" },
    { "src": "/static/(.*)", "dest": "/frontend/build/static/$1" },
    { "src": "/(.*\\.(js|css|json|png|jpg|jpeg|svg|ico|txt|map))", "dest": "/frontend/build/$1" },
    { "src": "/(.*)", "dest": "/frontend/build/index.html" }
  ]
}